{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xcpc-workstation.dev/schemas/plugin-manifest.schema.json",
  "title": "XCPC Workstation Plugin Manifest",
  "type": "object",
  "required": ["id", "name", "version"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Unique plugin identifier (lowercase ASCII letters, digits, '-' or '_')."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable plugin display name."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic version string (e.g. '0.1.0')."
    },
    "description": {
      "type": "string",
      "default": "",
      "description": "Short description shown in Settings and Tools."
    },
    "author": {
      "type": "string",
      "description": "Plugin author name or handle."
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "Repository or documentation URL."
    },
    "entry": {
      "type": "string",
      "default": "index.js",
      "minLength": 1,
      "description": "Relative path to the QuickJS sandbox entry script."
    },
    "ui_entry": {
      "type": "string",
      "minLength": 1,
      "description": "Optional relative path to the desktop NSH UI script (runs outside QuickJS sandbox)."
    },
    "capabilities": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["oj_source", "tool", "commands", "importer", "exporter", "credentials"]
      },
      "description": "Declared extension points implemented by this plugin."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domains": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "HTTP host whitelist (exact host or '*.example.com'; '*' is forbidden)."
        },
        "workspace_read": {
          "type": "boolean",
          "default": false,
          "description": "Whether the plugin may read problem metadata/statements from the active workspace."
        }
      }
    },
    "credentials": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "secret": { "type": "boolean", "default": true },
          "required": { "type": "boolean", "default": false },
          "placeholder": { "type": "string" }
        }
      }
    },
    "tools": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "inputs": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "required": ["name", "label", "kind"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "kind": {
                  "type": "string",
                  "enum": ["string", "text", "multiline", "number", "boolean", "select"]
                },
                "default": {},
                "options": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "required": { "type": "boolean", "default": false }
              }
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "context": {
            "type": "string",
            "enum": ["global", "problem", "contest"],
            "default": "global"
          }
        }
      }
    },
    "importers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "extensions": {
            "type": "array",
            "default": [],
            "items": { "type": "string" }
          }
        }
      }
    },
    "exporters": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "name", "extension"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "extension": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
