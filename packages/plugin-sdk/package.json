{
  "name": "@xcpc-workstation/plugin-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK (QuickJS host + WebView bridge) and Vite single-file HTML build plugin for XCPC Workstation plugins.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihaoze123/xcpc-workstation.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/lihaoze123/xcpc-workstation/tree/main/packages/plugin-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./host": {
      "types": "./host.d.ts",
      "default": "./host.js"
    },
    "./ui": {
      "types": "./ui.d.ts",
      "default": "./ui.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "import": "./vite.mjs",
      "default": "./vite.mjs"
    },
    "./manifest.schema.json": "./manifest.schema.json"
  },
  "files": [
    "host.d.ts",
    "host.js",
    "ui.d.ts",
    "ui.js",
    "vite.d.ts",
    "vite.mjs",
    "manifest.schema.json",
    "README.md"
  ],
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
