{
  "name": "XCPC Workstation",
  "id": "dev.xcpc.workstation",
  "version": "0.5.0",
  "build": 12,
  "rust": ".",
  "capabilities": {
    "webview": {
      "hosts": []
    },
    "clipboard": true,
    "statusBar": true,
    "application": true,
    "windows": true,
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    }
  },
  "updater": {
    "github": "lihaoze123/xcpc-workstation",
    "publicKey": "pwNYzmuxVIlJQUm37UN13Bl14aXIFbYnEx/WmZ8zXME="
  },
  "window": {
    "titleBar": {
      "style": "hidden",
      "height": 44
    },
    "defaultSize": {
      "width": 1280,
      "height": 820
    },
    "minSize": {
      "width": 960,
      "height": 640
    },
    "restoreBounds": true
  },
  "dependencies": {
    "nsh-icon": "^0.2.2",
    "nsh-icon-lucide": "^0.2.2",
    "nsh-o11y": "^0.1.0"
  }
}
